{
  "name": "quest-scheduler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "desktop:dev": "concurrently -k -n web,app \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@hyunbinseo/holidays-kr": "^5.2027.2",
    "@supabase/supabase-js": "^2.119.0",
    "galmuri": "^2.40.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "electron@33.2.1": true,
    "esbuild@0.21.5": true
  },
  "description": "업무를 게임 퀘스트처럼 관리하는 스케줄러",
  "author": "quest-scheduler",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.quest.scheduler",
    "productName": "QuestScheduler",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "퀘스트 스케줄러",
      "deleteAppDataOnUninstall": true,
      "include": "electron/installer.nsh"
    }
  }
}
